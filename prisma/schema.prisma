generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BoardStatus {
  ACTIVE
  ARCHIVED
  TRASHED
}

enum ShareMode {
  VIEW
  COPY
}

enum GameStatus {
  LOBBY
  ACTIVE
  FINISHED
}

enum MemberRole {
  COHOST
  SCOREKEEPER
}

enum HostRole {
  HOST
  COHOST
  SCOREKEEPER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   @default("")
  passwordHash String?
  /// Keycloak / OIDC subject, set on first SSO sign-in
  oidcSub      String?  @unique
  isAdmin      Boolean  @default(false)
  gameDefaults Json?
  createdAt    DateTime @default(now())

  sessions    Session[]
  boards      Board[]
  media       Media[]
  games       Game[]
  ownedTeams  Membership[] @relation("owner")
  memberships Membership[] @relation("member")
  invites     Invite[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model MagicLink {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// An owner shares their boards/games with a co-host or scorekeeper.
model Membership {
  id        String     @id @default(cuid())
  ownerId   String
  owner     User       @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberId  String
  member    User       @relation("member", fields: [memberId], references: [id], onDelete: Cascade)
  role      MemberRole
  createdAt DateTime   @default(now())

  @@unique([ownerId, memberId])
}

model Invite {
  id         String     @id @default(cuid())
  ownerId    String
  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  email      String
  role       MemberRole
  tokenHash  String     @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime   @default(now())
}

model Board {
  id          String      @id @default(cuid())
  ownerId     String
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  description String      @default("")
  tags        String[]    @default([])
  folder      String      @default("")
  content     Json
  status      BoardStatus @default(ACTIVE)
  trashedAt   DateTime?
  shareToken  String?     @unique
  shareMode   ShareMode   @default(VIEW)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  versions BoardVersion[]
  games    Game[]

  @@index([ownerId, status])
}

model BoardVersion {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title     String
  content   Json
  label     String   @default("")
  createdAt DateTime @default(now())

  @@index([boardId, createdAt])
}

model Media {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  key       String   @unique
  mime      String
  size      Int
  filename  String   @default("")
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model Game {
  id            String     @id @default(cuid())
  code          String
  ownerId       String
  owner         User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  boardId       String?
  board         Board?     @relation(fields: [boardId], references: [id], onDelete: SetNull)
  boardTitle    String
  status        GameStatus @default(LOBBY)
  setup         Json
  actions       Json       @default("[]")
  state         Json?
  rematchOfId   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  finishedAt    DateTime?

  players       GamePlayer[]
  pairingTokens PairingToken[]
  hostGrants    HostGrant[]

  @@index([code, status])
  @@index([ownerId, status])
}

model GamePlayer {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId  String
  tokenHash String
  createdAt DateTime @default(now())

  @@unique([gameId, playerId])
  @@index([tokenHash])
}

model PairingToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  gameId    String
  game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId    String
  role      HostRole
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model HostGrant {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId    String
  role      HostRole
  expiresAt DateTime
  createdAt DateTime @default(now())
}
