generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // The address is in prisma.config.ts (CLI) and src/server/dbAdapter.ts (the app).
}

enum BoardStatus {
  ACTIVE
  ARCHIVED
  TRASHED
}

enum ShareMode {
  VIEW
  COPY
}

enum GameStatus {
  LOBBY
  ACTIVE
  FINISHED
}

enum MemberRole {
  COHOST
  SCOREKEEPER
}

enum HostRole {
  HOST
  COHOST
  SCOREKEEPER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   @default("")
  passwordHash String?
  /// Keycloak / OIDC subject, set on first SSO sign-in
  oidcSub      String?  @unique
  isAdmin      Boolean  @default(false)
  gameDefaults Json?
  createdAt    DateTime @default(now())

  sessions    Session[]
  boards      Board[]
  media       Media[]
  games       Game[]
  ownedTeams  Membership[] @relation("owner")
  memberships Membership[] @relation("member")
  invites     Invite[]
  apiTokens   ApiToken[]
  oauthCodes  OAuthCode[]
  oauthGrants OAuthGrant[]
  player      PlayerProfile?
}

/// A personal access token for the board API and the MCP server. Only its hash is stored.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  /// Last four characters, to tell tokens apart in the list.
  hint       String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// An AI app that registered itself to sign people in (OAuth dynamic client registration).
/// Public clients only: there is no client secret.
model OAuthClient {
  id           String       @id
  name         String
  redirectUris String[]
  createdAt    DateTime     @default(now())
  codes        OAuthCode[]
  grants       OAuthGrant[]
}

/// A one-time authorization code (5 minutes). Only its hash is stored.
model OAuthCode {
  id            String      @id @default(cuid())
  codeHash      String      @unique
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri   String
  codeChallenge String
  expiresAt     DateTime

  @@index([expiresAt])
}

/// One app connected to one account: its current access and refresh tokens (hashes only).
model OAuthGrant {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId         String
  client           OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  accessHash       String      @unique
  accessExpiresAt  DateTime
  refreshHash      String      @unique
  refreshExpiresAt DateTime
  lastUsedAt       DateTime?
  createdAt        DateTime    @default(now())

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model MagicLink {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// An owner shares their boards/games with a co-host or scorekeeper.
model Membership {
  id        String     @id @default(cuid())
  ownerId   String
  owner     User       @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberId  String
  member    User       @relation("member", fields: [memberId], references: [id], onDelete: Cascade)
  role      MemberRole
  createdAt DateTime   @default(now())

  @@unique([ownerId, memberId])
}

model Invite {
  id         String     @id @default(cuid())
  ownerId    String
  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  email      String
  role       MemberRole
  tokenHash  String     @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime   @default(now())
}

model Board {
  id          String      @id @default(cuid())
  ownerId     String
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  description String      @default("")
  tags        String[]    @default([])
  folder      String      @default("")
  content     Json
  status      BoardStatus @default(ACTIVE)
  trashedAt   DateTime?
  shareToken  String?     @unique
  shareMode   ShareMode   @default(VIEW)
  /// Listed in the public gallery (requires a share link in COPY mode).
  listed      Boolean     @default(false)
  listedAt    DateTime?
  /// How many times the board was copied from its share link.
  copies      Int         @default(0)
  /// Content revision, bumped on every content save (detects concurrent edits).
  rev         Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  versions BoardVersion[]
  games    Game[]

  @@index([ownerId, status])
  @@index([listed, listedAt])
}

model BoardVersion {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title     String
  content   Json
  label     String   @default("")
  createdAt DateTime @default(now())

  @@index([boardId, createdAt])
}

model Media {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  key       String   @unique
  mime      String
  size      Int
  filename  String   @default("")
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model Game {
  id          String     @id @default(cuid())
  code        String
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  boardId     String?
  board       Board?     @relation(fields: [boardId], references: [id], onDelete: SetNull)
  boardTitle  String
  status      GameStatus @default(LOBBY)
  setup       Json
  actions     Json       @default("[]")
  state       Json?
  rematchOfId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  finishedAt  DateTime?

  players       GamePlayer[]
  pairingTokens PairingToken[]
  hostGrants    HostGrant[]

  @@index([code, status])
  @@index([ownerId, status])
}

model GamePlayer {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId  String
  tokenHash String
  /// The saved player sitting in this seat, if they chose to be remembered.
  profileId String?
  profile   PlayerProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([gameId, playerId])
  @@index([tokenHash])
  @@index([profileId])
}

/// A player's saved name, drawings and results. Found again by a cookie on the device (only
/// its hash is stored) or by the account it was saved to. Nobody needs one to play.
model PlayerProfile {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String
  signature  Json?
  avatar     Json?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  results PlayerResult[]
  seats   GamePlayer[]
}

/// One finished game for one saved player. gameId is not a relation: the result outlives the game.
model PlayerResult {
  id          String        @id @default(cuid())
  profileId   String
  profile     PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  gameId      String
  boardTitle  String
  score       Int
  place       Int
  contestants Int
  right       Int
  wrong       Int
  team        Boolean       @default(false)
  finishedAt  DateTime

  @@unique([profileId, gameId])
  @@index([gameId])
}

model PairingToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  gameId    String
  game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId    String
  role      HostRole
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model HostGrant {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId    String
  role      HostRole
  expiresAt DateTime
  createdAt DateTime @default(now())
}
