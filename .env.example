# ---- Core -------------------------------------------------------------
# Public URL people use to reach the app (used for QR codes, magic links, cookies).
APP_URL=http://localhost:3000
PORT=3000
# Long random string. Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string

# ---- Database ---------------------------------------------------------
DATABASE_URL=postgresql://jeppidy:jeppidy@localhost:5432/jeppidy?schema=public

# ---- Accounts ---------------------------------------------------------
# Set to false after you've created your account to stop strangers signing up.
ALLOW_SIGNUP=true
# Comma-separated emails that get the super-admin page. (The first account is always admin.)
ADMIN_EMAILS=
# Magic-link email. Leave empty and links are printed to the server log instead.
# e.g. smtp://user:pass@smtp.example.com:587  or  smtps://user:pass@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM="Trivia Pig <no-reply@example.com>"

# ---- Keycloak / OIDC sign-in (optional) -------------------------------
# e.g. https://auth.example.com/realms/trivia  (leave empty to disable SSO)
OIDC_ISSUER=
OIDC_CLIENT_ID=trivia-pig
OIDC_CLIENT_SECRET=
OIDC_LABEL=Keycloak
OIDC_ADMIN_ROLE=trivia-admin
OIDC_REQUIRED_ROLE=
# false = only SSO; no email/password or magic links
LOCAL_AUTH=true

# ---- Media storage ----------------------------------------------------
# local = ./uploads on disk; s3 = any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=jeppidy
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# true for MinIO, false for AWS S3 / R2
S3_FORCE_PATH_STYLE=true

# ---- Branding ---------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Trivia Pig
