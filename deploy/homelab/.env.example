# Copy to .env and fill in. Generate secrets with:  openssl rand -base64 36

# ---- App ---------------------------------------------------------------
APP_URL=https://triviapig.lol
APP_NAME=Trivia Pig
AUTH_SECRET=
POSTGRES_PASSWORD=
# Build locally (docker compose build) or pull the image that CI publishes after its tests pass.
# With these two set, scripts/install-autodeploy.sh keeps the site on the newest passing build.
# APP_IMAGE=ghcr.io/your-github-user/trivia-pig:latest
# APP_PULL_POLICY=always
# Refuse any image that was not built and signed by your repository's publish workflow
# (checked with cosign before each deploy). A regular expression for the signer's identity:
# VERIFY_IMAGE_SIGNER=^https://github.com/your-github-user/trivia-pig/\.github/workflows/docker\.yml@refs/(heads/main|tags/v.*)$
# Deploy even with devices connected once their games have been idle this many minutes.
# DEPLOY_IDLE_MIN=20

# ---- Notifications ----------------------------------------------------
# Where scripts/monitor.sh and scripts/update.sh send alerts (app down, crashed, busy, disk,
# backups, deploys). An ntfy topic (https://ntfy.sh/<long-private-name>, with the ntfy phone
# app), a Discord webhook or a Slack webhook. Test with: ./scripts/notify.sh test
# ALERT_URL=
# Alert when this many devices are connected at once.
# ALERT_USERS=100
# Optional: a healthchecks.io-style ping URL, hit every minute while the app is healthy, so you
# hear about it when the whole machine is off.
# HEARTBEAT_URL=
# Memory ceiling for the app container (it restarts if it ever exceeds this).
APP_MEM_LIMIT=1g

# ---- Backups ----------------------------------------------------------
# Nightly at this hour (0-23, in TZ) into ./data/backups; see scripts/backup.sh.
TZ=America/Denver
BACKUP_HOUR=4
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_MONTHLY=6

# Turn off public sign-ups once your account exists (ignored for Keycloak users).
ALLOW_SIGNUP=false
# Seed demo@example.com / demo1234 on startup. Leave false in production.
SEED_DEMO=false
ADMIN_EMAILS=

# ---- Cloudflare Tunnel ------------------------------------------------
TUNNEL_TOKEN=

# ---- Keycloak (OIDC) --------------------------------------------------
# Using your existing Keycloak? Point OIDC_ISSUER at its realm and create a
# confidential client with redirect URI  https://triviapig.lol/api/auth/oidc/callback
# Using the bundled one (--profile keycloak)? These defaults match keycloak/trivia-realm.json.
OIDC_ISSUER=https://auth.triviapig.lol/realms/trivia
OIDC_CLIENT_ID=trivia-pig
OIDC_LABEL=Keycloak
OIDC_CLIENT_SECRET=
# Realm/client role that makes someone a super-admin in the app
OIDC_ADMIN_ROLE=trivia-admin
# Optional: only users with this role may sign in to host/build boards
OIDC_REQUIRED_ROLE=
# false = Keycloak is the only way to sign in (no passwords / magic links in the app)
LOCAL_AUTH=false

# Bundled Keycloak only
KEYCLOAK_HOST=auth.triviapig.lol
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# ---- Email (optional; magic links / invites) --------------------------
SMTP_URL=
MAIL_FROM="Trivia Pig <no-reply@triviapig.lol>"

# ---- Media storage ----------------------------------------------------
# local = ./data/uploads (simplest). s3 = MinIO (--profile minio), R2, or S3.
STORAGE_DRIVER=local
MAX_UPLOAD_MB=10
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=trivia
S3_ACCESS_KEY_ID=trivia
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---- AI board drafts (optional) ---------------------------------------
# Leave empty to hide the "Draft with AI" button. Each draft is billed to this key.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Drafts allowed per host per hour
AI_DRAFTS_PER_HOUR=10
