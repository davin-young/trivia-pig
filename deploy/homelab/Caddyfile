# Only used with:  docker compose --profile caddy up -d
# Caddy gets Let's Encrypt certificates automatically; forward ports 80 and 443 to this host.
# If DNS is proxied through Cloudflare (orange cloud), set SSL/TLS mode to "Full (strict)".

triviapig.lol {
	encode zstd gzip
	# WebSockets (Socket.IO) are proxied automatically.
	reverse_proxy app:3000
}

www.triviapig.lol {
	redir https://triviapig.lol{uri} permanent
}

